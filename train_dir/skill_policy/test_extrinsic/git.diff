-+-+                 prompt: str = 'original',
-+-+                 goal_key: str = '') -> None:
-+-+
-+-+        self.blstats_keys = [
-+-+           'NLE_BL_DEPTH', 'NLE_BL_GOLD', 'NLE_BL_HP',
-+-+           'NLE_BL_HPMAX', 'NLE_BL_XP', 'NLE_BL_HUNGER'
-+-+        ]
-+-+        if debug:
-+-+            self.llm = None
-+-+        else:
-+-+            self.llm = OllamaLanguageModel(seed=seed, system_prompt=system_prompts[prompt],
